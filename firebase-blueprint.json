{
  "entities": {
    "UserProgress": {
      "title": "User Progress",
      "description": "Stores user learning progress.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "completedLessons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "userId"
      ]
    },
    "ChatSession": {
      "title": "Chat Session",
      "description": "Stores user chat sessions for AI tutors.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": { "type": "string", "enum": ["user", "model"] },
              "text": { "type": "string" }
            },
            "required": ["role", "text"]
          }
        },
        "lang": { "type": "string", "enum": ["EN", "CN"] },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "title", "messages", "lang", "createdAt"]
    },
    "UserMemory": {
      "title": "User Memory",
      "description": "Stores user learning profile, preferences and facts across chat and call.",
      "type": "object",
      "properties": {
        "memories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "updatedAt": { "type": "number" }
      },
      "required": ["memories"]
    },
    "LearningPlan": {
      "title": "Learning Plan",
      "description": "Stores user generated learning plan.",
      "type": "object",
      "properties": {
        "plan": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["plan", "updatedAt"]
    },
    "RoleplayProgress": {
      "title": "Roleplay Progress",
      "description": "Stores per-mission completion, stars (0-3), and best scores for Real-Life Roleplay Missions separated by language.",
      "type": "object",
      "properties": {
        "missionId": { "type": "string" },
        "lang": { "type": "string", "enum": ["EN", "CN"] },
        "completed": { "type": "boolean" },
        "stars": { "type": "number" },
        "bestScore": { "type": "number" },
        "objectivesCompletedCount": { "type": "number" },
        "playCount": { "type": "number" },
        "lastPlayedAt": { "type": "number" }
      },
      "required": ["missionId", "lang", "completed", "stars", "bestScore", "lastPlayedAt"]
    },
    "KaraokeSongCache": {
      "title": "Karaoke Song Cache",
      "description": "Global shared cache of resolved YouTube videos, synced LRC lines, Thai translations, Pinyin, and extracted vocabulary decks.",
      "type": "object",
      "properties": {
        "songKey": { "type": "string", "maxLength": 128 },
        "curatedId": { "type": "string", "maxLength": 64 },
        "videoId": { "type": "string", "maxLength": 32 },
        "alternativeVideoIds": { "type": "array" },
        "title": { "type": "string", "maxLength": 200 },
        "artist": { "type": "string", "maxLength": 200 },
        "language": { "type": "string", "enum": ["en", "zh"] },
        "difficulty": { "type": "string", "enum": ["beginner", "intermediate", "advanced"] },
        "thumbnailUrl": { "type": "string", "maxLength": 400 },
        "durationSec": { "type": "number" },
        "isSynced": { "type": "boolean" },
        "lrcSource": { "type": "string", "enum": ["lrclib", "manual", "plain"] },
        "lines": { "type": "array" },
        "vocabDeck": { "type": "array" },
        "playCount": { "type": "number" },
        "cachedAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "createdByUid": { "type": "string", "maxLength": 128 }
      },
      "required": ["songKey", "videoId", "title", "artist", "language", "lines", "vocabDeck", "cachedAt", "updatedAt"]
    },
    "KaraokeFavorite": {
      "title": "Karaoke Favorite",
      "description": "User bookmarked favorite karaoke song.",
      "type": "object",
      "properties": {
        "songKey": { "type": "string" },
        "curatedId": { "type": "string" },
        "videoId": { "type": "string" },
        "title": { "type": "string" },
        "artist": { "type": "string" },
        "language": { "type": "string", "enum": ["en", "zh"] },
        "thumbnailUrl": { "type": "string" },
        "addedAt": { "type": "number" }
      },
      "required": ["songKey", "title", "artist", "language", "addedAt"]
    },
    "KaraokeHistory": {
      "title": "Karaoke History",
      "description": "User recently sung karaoke songs and best gap-fill quiz scores.",
      "type": "object",
      "properties": {
        "songKey": { "type": "string" },
        "curatedId": { "type": "string" },
        "videoId": { "type": "string" },
        "title": { "type": "string" },
        "artist": { "type": "string" },
        "language": { "type": "string", "enum": ["en", "zh"] },
        "thumbnailUrl": { "type": "string" },
        "lastPlayedAt": { "type": "number" },
        "playCount": { "type": "number" },
        "bestQuizScore": { "type": "number" },
        "bestQuizTotal": { "type": "number" }
      },
      "required": ["songKey", "videoId", "title", "artist", "language", "lastPlayedAt", "playCount"]
    },
    "KaraokeSyncOffset": {
      "title": "Karaoke Sync Offset",
      "description": "Per-video user lyrics timing offset in seconds.",
      "type": "object",
      "properties": {
        "videoId": { "type": "string" },
        "offsetSec": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["videoId", "offsetSec", "updatedAt"]
    },
    "KaraokeCommunityIndex": {
      "title": "Karaoke Community Song Index",
      "description": "Lightweight public listing of quality-checked YouTube karaoke songs translated by users so everyone can sing them for free.",
      "type": "object",
      "properties": {
        "songKey": { "type": "string", "maxLength": 128 },
        "videoId": { "type": "string", "maxLength": 32 },
        "title": { "type": "string", "maxLength": 200 },
        "artist": { "type": "string", "maxLength": 200 },
        "language": { "type": "string", "enum": ["en", "zh"] },
        "thumbnailUrl": { "type": "string", "maxLength": 400 },
        "durationSec": { "type": "number" },
        "lineCount": { "type": "number" },
        "vocabCount": { "type": "number" },
        "isSynced": { "type": "boolean" },
        "isPublic": { "type": "boolean" },
        "playCount": { "type": "number" },
        "addedAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "createdByUid": { "type": "string", "maxLength": 128 }
      },
      "required": ["songKey", "videoId", "title", "artist", "language", "lineCount", "isSynced", "isPublic", "playCount", "addedAt", "updatedAt"]
    },
    "ByokDailyUsage": {
      "title": "BYOK Daily Usage",
      "description": "Tracks daily free BYOK quota usage aligned with Google Pacific midnight reset (7 vocab / 3 mock tests / 3 karaoke translations / 1 AI subtitle clip <= 5 min).",
      "type": "object",
      "properties": {
        "periodKey": { "type": "string" },
        "vocab_exam": { "type": "number" },
        "mock_test": { "type": "number" },
        "karaoke_translate": { "type": "number" },
        "video_subtitle": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["periodKey", "vocab_exam", "mock_test", "karaoke_translate", "video_subtitle", "updatedAt"]
    },
    "WordbookSrsEntry": {
      "title": "Personal SRS Wordbook Entry",
      "description": "User saved vocabulary entry with Spaced Repetition (SRS) scheduling state.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lang": { "type": "string", "enum": ["EN", "CN"] },
        "word": { "type": "string" },
        "reading": { "type": "string" },
        "meaningTh": { "type": "string" },
        "partOfSpeech": { "type": "string" },
        "example": { "type": "string" },
        "exampleTh": { "type": "string" },
        "note": { "type": "string" },
        "source": { "type": "string", "enum": ["lessons", "flashcards", "karaoke", "reading", "manual"] },
        "sourceLabel": { "type": "string" },
        "stage": { "type": "number" },
        "intervalDays": { "type": "number" },
        "repetitions": { "type": "number" },
        "lapses": { "type": "number" },
        "nextReviewAt": { "type": "number" },
        "lastReviewedAt": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "lang", "word", "meaningTh", "source", "stage", "intervalDays", "repetitions", "lapses", "nextReviewAt", "createdAt", "updatedAt"]
    },
    "WordbookDailyReviewLog": {
      "title": "Wordbook Daily Review Log",
      "description": "Tracks daily SRS review counts per language for streak and progress analytics.",
      "type": "object",
      "properties": {
        "dateKey": { "type": "string" },
        "lang": { "type": "string", "enum": ["EN", "CN"] },
        "reviewedCount": { "type": "number" },
        "rememberedCount": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["dateKey", "lang", "reviewedCount", "rememberedCount", "updatedAt"]
    },
    "MistakeNotebookEntry": {
      "title": "Smart Mistake Notebook Entry",
      "description": "Auto-captured wrong answer from Vocab Exam, Exams, Mock Tests, or Reading with 2-consecutive-correct mastery tracking.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lang": { "type": "string", "enum": ["EN", "CN"] },
        "source": { "type": "string", "enum": ["vocab_exam", "exams", "mock_test", "reading"] },
        "sourceLabel": { "type": "string" },
        "prompt": { "type": "string" },
        "reading": { "type": "string" },
        "options": { "type": "array" },
        "correctOptionIndex": { "type": "number" },
        "userWrongAnswer": { "type": "string" },
        "correctAnswer": { "type": "string" },
        "acceptedAnswers": { "type": "array" },
        "explanationTh": { "type": "string" },
        "vocabWord": { "type": "string" },
        "vocabMeaningTh": { "type": "string" },
        "vocabExample": { "type": "string" },
        "wrongCount": { "type": "number" },
        "consecutiveCorrect": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "mastered"] },
        "masteredAt": { "type": "number" },
        "lastPracticedAt": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "lang", "source", "sourceLabel", "prompt", "userWrongAnswer", "correctAnswer", "wrongCount", "consecutiveCorrect", "status", "createdAt", "updatedAt"]
    },
    "ShadowingDailyLog": {
      "title": "Shadowing Daily Practice Log",
      "description": "Lightweight daily summary of sentence shadowing practice counts and accuracy per language.",
      "type": "object",
      "properties": {
        "dateKey": { "type": "string" },
        "lang": { "type": "string", "enum": ["EN", "CN"] },
        "practiceCount": { "type": "number" },
        "bestAccuracyPct": { "type": "number" },
        "totalAccuracySum": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["dateKey", "lang", "practiceCount", "bestAccuracyPct", "totalAccuracySum", "updatedAt"]
    },
    "ReadingProgressEntry": {
      "title": "Graded Reading Progress Entry",
      "description": "Tracks completed stories and best comprehension quiz scores per user.",
      "type": "object",
      "properties": {
        "storyId": { "type": "string" },
        "lang": { "type": "string", "enum": ["EN", "CN"] },
        "level": { "type": "string" },
        "completed": { "type": "boolean" },
        "bestQuizScore": { "type": "number" },
        "quizTotal": { "type": "number" },
        "readCount": { "type": "number" },
        "lastReadAt": { "type": "number" }
      },
      "required": ["storyId", "lang", "level", "completed", "bestQuizScore", "quizTotal", "readCount", "lastReadAt"]
    },
    "ReadingCustomArticle": {
      "title": "User Custom Pasted Article",
      "description": "User-imported article analyzed into bilingual sentences, key vocab, and 3 comprehension quiz questions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lang": { "type": "string", "enum": ["EN", "CN"] },
        "level": { "type": "string" },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "titlePinyin": { "type": "string" },
        "titleTh": { "type": "string" },
        "summaryTh": { "type": "string" },
        "estimatedMinutes": { "type": "number" },
        "sentences": { "type": "array" },
        "vocab": { "type": "array" },
        "quiz": { "type": "array" },
        "isCustom": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "lang", "level", "category", "title", "titleTh", "sentences", "vocab", "quiz"]
    }
  },
  "firestore": {
    "/user_progress/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProgress"
      },
      "description": "User progress data indexed by user ID."
    },
    "/users/{userId}/chat_sessions/{sessionId}": {
      "schema": {
        "$ref": "#/entities/ChatSession"
      },
      "description": "User chat sessions for AI tutors."
    },
    "/users/{userId}/memory/global": {
      "schema": {
        "$ref": "#/entities/UserMemory"
      },
      "description": "User learning profile and general memories."
    },
    "/users/{userId}/learning_plans/{planId}": {
      "schema": {
        "$ref": "#/entities/LearningPlan"
      },
      "description": "User learning plan."
    },
    "/users/{userId}/roleplay_progress/{progressId}": {
      "schema": {
        "$ref": "#/entities/RoleplayProgress"
      },
      "description": "User completion, stars, and best scores for Real-Life Roleplay Missions."
    },
    "/karaoke_songs/{songKey}": {
      "schema": {
        "$ref": "#/entities/KaraokeSongCache"
      },
      "description": "Global shared cache of translated karaoke songs so repeat plays are instant and free for everyone."
    },
    "/karaoke_community_index/{songKey}": {
      "schema": {
        "$ref": "#/entities/KaraokeCommunityIndex"
      },
      "description": "Public quality-filtered index of user-added YouTube karaoke songs (synced lyrics, >= 8 lines) listed in the Community Library tab."
    },
    "/users/{userId}/karaoke_favorites/{songKey}": {
      "schema": {
        "$ref": "#/entities/KaraokeFavorite"
      },
      "description": "User favorite karaoke songs."
    },
    "/users/{userId}/karaoke_history/{songKey}": {
      "schema": {
        "$ref": "#/entities/KaraokeHistory"
      },
      "description": "User karaoke listening history and quiz high scores."
    },
    "/users/{userId}/karaoke_offsets/{videoId}": {
      "schema": {
        "$ref": "#/entities/KaraokeSyncOffset"
      },
      "description": "User saved per-video sync offset adjustments."
    },
    "/users/{userId}/settings/byok_daily_usage": {
      "schema": {
        "$ref": "#/entities/ByokDailyUsage"
      },
      "description": "Daily free BYOK quota usage counters synced across user devices."
    },
    "/users/{userId}/wordbook_srs/{wordId}": {
      "schema": {
        "$ref": "#/entities/WordbookSrsEntry"
      },
      "description": "User personal SRS vocabulary entries synced across devices."
    },
    "/users/{userId}/wordbook_review_logs/{logId}": {
      "schema": {
        "$ref": "#/entities/WordbookDailyReviewLog"
      },
      "description": "Daily SRS review activity counts per language."
    },
    "/users/{userId}/mistake_notebook/{mistakeId}": {
      "schema": {
        "$ref": "#/entities/MistakeNotebookEntry"
      },
      "description": "Auto-captured user mistakes from exams and quizzes with 2-streak mastery status."
    },
    "/users/{userId}/shadowing_logs/{logId}": {
      "schema": {
        "$ref": "#/entities/ShadowingDailyLog"
      },
      "description": "Daily shadowing practice counts and average accuracy per language for Streak and Speaking analytics."
    },
    "/users/{userId}/reading_progress/{storyId}": {
      "schema": {
        "$ref": "#/entities/ReadingProgressEntry"
      },
      "description": "User reading completion status and best quiz scores for Graded Reading Studio stories."
    },
    "/users/{userId}/reading_custom/{articleId}": {
      "schema": {
        "$ref": "#/entities/ReadingCustomArticle"
      },
      "description": "User-pasted custom reading articles saved for unlimited free re-reading."
    }
  }
}
