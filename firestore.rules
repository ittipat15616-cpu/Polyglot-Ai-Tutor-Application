rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }
    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return request.auth.uid == userId; }
    function isAdmin() { return request.auth != null && 'email' in request.auth.token && (request.auth.token.email == 'ittipat15616@gmail.com' || request.auth.token.email == 'weeranan172550@gmail.com' || request.auth.token.email == 'nongrily@gmail.com' || request.auth.token.email == 'mimi.benyapa@gmail.com' || request.auth.token.email == 'tpimlapat69@gmail.com'); }
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Validation Blueprints
    function isValidUserProgress(data, userId) {
      return data.keys().hasAll(['userId']) 
        && data.userId == userId
        && data.userId == request.auth.uid
        && (!('completedLessons' in data) || (data.completedLessons is list && data.completedLessons.size() <= 1000));
    }
    function isValidChatSession(data) {
      return data.keys().hasAll(['id', 'title', 'messages', 'lang', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.messages is list && data.messages.size() <= 200
        && data.lang is string && (data.lang == 'EN' || data.lang == 'CN')
        && data.createdAt is number;
    }
    function isValidUserMemory(data) {
      return data.keys().hasAll(['memories'])
        && data.memories is list && data.memories.size() <= 50
        && (!('updatedAt' in data) || data.updatedAt is number);
    }
    match /user_progress/{userId} {
      allow read: if isSignedIn() && isOwner(userId) && isValidId(userId);
      allow create: if isSignedIn() 
        && isOwner(userId) 
        && isValidId(userId)
        && isValidUserProgress(incoming(), userId);
      allow update: if isSignedIn() 
        && isOwner(userId) 
        && isValidId(userId)
        && isValidUserProgress(incoming(), userId)
        && incoming().userId == existing().userId;
      allow delete: if false;
    }
    // All data nested under /users/{userId}
    match /users/{userId} {
      allow read, write: if isAdmin() || (isSignedIn() && isOwner(userId) && isValidId(userId));
      match /{document=**} {
        allow read, write: if isAdmin() || (isSignedIn() && isOwner(userId) && isValidId(userId));
      }
      match /chat_sessions/{sessionId} {
        allow read, delete: if isAdmin() || (isSignedIn() && isOwner(userId) && isValidId(userId) && isValidId(sessionId));
        allow create, update: if isAdmin() || (isSignedIn() 
          && isOwner(userId) 
          && isValidId(userId)
          && isValidId(sessionId)
          && isValidChatSession(incoming()));
      }
      match /learning_plans/{planId} {
        allow read: if isAdmin() || (isSignedIn() && isOwner(userId) && isValidId(userId));
        allow create, update: if isAdmin() || (isSignedIn() && isOwner(userId) && isValidId(userId) && isValidId(planId) && incoming().keys().hasAll(["plan", "updatedAt"]) && incoming().plan is string && incoming().updatedAt is number);
      }

      match /memory/global {
        allow read: if isAdmin() || (isSignedIn() && isOwner(userId) && isValidId(userId));
        allow create, update: if isAdmin() || (isSignedIn()
          && isOwner(userId)
          && isValidId(userId)
          && isValidUserMemory(incoming()));
      }
    }
    match /verified_slips/{transRef} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
